# Puerto del servidor Express de healthcheck (Render asigna PORT automáticamente)
PORT=3000

# API Key de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de Gemini principal (con respaldo automático a otros 6 modelos si alguno falla)
GEMINI_MODEL=gemini-3.5-flash-lite

# Personalidad del chatbot (opcional)
SYSTEM_INSTRUCTION="Eres Tridente, un asistente virtual amable, claro y conciso que responde mensajes por WhatsApp en español."

# Opcional: número de WhatsApp con código de país (sin + ni espacios) para vincular por código de 8 dígitos en vez de QR
WHATSAPP_PAIRING_NUMBER=

# Persistencia de sesión en Supabase (recomendado para Render; si se omiten, usa la carpeta local auth_info)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
